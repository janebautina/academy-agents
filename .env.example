# ── Нейросеть (любой OpenAI-совместимый API) / Model (any OpenAI-compatible API) ──
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com              LLM_MODEL=deepseek-chat
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini
#   YandexGPT: LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1   LLM_MODEL=gpt://<folder_id>/yandexgpt/latest   LLM_FOLDER_ID=<folder_id>
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_FOLDER_ID=

# ── Telegram (необязательно / optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ru или en — язык, на котором агенты пишут владельцу
COMPANY_LANGUAGE=ru

# ── Выдача доступа (урок 5) / Access delivery ──
DA_ACCESS_TOKEN=
COURSE_CHANNEL_RU=
COURSE_CHANNEL_EN=
COURSE_PRICES=RUB:2990,USD:49,EUR:45
MAIL_FROM=Alesha AI Academy <support@aleshaai.com>
RESEND_API_KEY=
